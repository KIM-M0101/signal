{
  "expo": {
    "name": "하루시그널",
    "slug": "signal-house",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signalhouse.prototype"
    },
    "android": {
      "package": "com.signalhouse.prototype"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "상대방 프로필 사진을 고를 때 사진 보관함을 사용합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C4BC1"
        }
      ],
      "expo-font"
    ]
  }
}
